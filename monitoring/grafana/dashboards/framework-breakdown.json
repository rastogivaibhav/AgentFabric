{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Govagn — per-framework span volume, token usage, latency, and error rates",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Platform Overview", "url": "/d/govagn-overview", "type": "dashboards" }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Framework Distribution",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_spans_received_total[10m])) by (framework)",
          "legendFormat": "{{ framework }}"
        }
      ],
      "title": "Span Share by Framework (10m)",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_spans_received_total[2m])) by (framework) * 60",
          "legendFormat": "{{ framework }}"
        }
      ],
      "title": "Spans/min by Framework",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Token Usage",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "fillOpacity": 10, "lineWidth": 2 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_tokens_total{type=\"input\"}[5m])) by (framework) * 60",
          "legendFormat": "{{ framework }} input"
        },
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_tokens_total{type=\"output\"}[5m])) by (framework) * 60",
          "legendFormat": "{{ framework }} output"
        }
      ],
      "title": "Tokens/min by Framework (input vs output)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2,
            "axisLabel": "input:output ratio"
          },
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_tokens_total{type=\"input\"}[10m])) by (framework) / sum(rate(govagn_tokens_total{type=\"output\"}[10m])) by (framework)",
          "legendFormat": "{{ framework }} input/output ratio"
        }
      ],
      "title": "Input/Output Token Ratio by Framework",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "title": "Agent Run Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(govagn_agent_run_duration_seconds_bucket[5m])) by (le, framework))",
          "legendFormat": "{{ framework }} P95"
        }
      ],
      "title": "Agent Run P95 Latency by Framework",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "100 * sum(rate(govagn_agent_runs_total{status=\"error\"}[5m])) by (framework) / sum(rate(govagn_agent_runs_total[5m])) by (framework)",
          "legendFormat": "{{ framework }} error %"
        }
      ],
      "title": "Agent Run Error Rate by Framework",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "Top Agents",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 7,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "topk(10, sum(rate(govagn_spans_received_total[10m])) by (agent_name) * 60)",
          "legendFormat": "{{ agent_name }}"
        }
      ],
      "title": "Top 10 Agents by Span Rate",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 8,
      "options": {
        "displayMode": "gradient",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "topk(10, sum(rate(govagn_cost_usd_total[1h])) by (agent_name) * 3600)",
          "legendFormat": "{{ agent_name }}"
        }
      ],
      "title": "Top 10 Agents by Cost Rate (USD/hour)",
      "type": "bargauge"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["govagn", "frameworks", "ai-agents"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
        "definition": "label_values(govagn_spans_received_total, framework)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "framework",
        "options": [],
        "query": "label_values(govagn_spans_received_total, framework)",
        "refresh": 2,
        "type": "query",
        "label": "Framework"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Govagn — Framework Breakdown",
  "uid": "govagn-framework",
  "version": 1
}
