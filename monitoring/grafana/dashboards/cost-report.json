{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Govagn — AI cost tracking, model spend, token economy, and budget alerting",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Platform Overview", "url": "/d/govagn-overview", "type": "dashboards" }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Cost Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }] },
          "unit": "currencyUSD",
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "datasource": { "uid": "govagn-prometheus" }, "expr": "rate(govagn_cost_usd_total[1h]) * 3600", "legendFormat": "USD/hour" }
      ],
      "title": "Current Cost Rate (USD/hour)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [
        { "datasource": { "uid": "govagn-prometheus" }, "expr": "increase(govagn_cost_usd_total[24h])", "legendFormat": "24h total" }
      ],
      "title": "Total Cost (Last 24h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["sum"] } },
      "targets": [
        { "datasource": { "uid": "govagn-prometheus" }, "expr": "increase(govagn_tokens_total[24h])", "legendFormat": "24h tokens" }
      ],
      "title": "Total Tokens (Last 24h)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.0001 }, { "color": "red", "value": 0.001 }] },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "rate(govagn_cost_usd_total[5m]) / rate(govagn_tokens_total[5m])",
          "legendFormat": "USD/token"
        }
      ],
      "title": "Cost per Token",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Cost Trends",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "fillOpacity": 15, "lineWidth": 2 },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": { "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_cost_usd_total[5m])) by (framework) * 3600",
          "legendFormat": "{{ framework }}"
        }
      ],
      "title": "Cost Rate by Framework (USD/hour)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": { "legend": { "calcs": ["sum", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_cost_usd_total[5m])) by (model) * 3600",
          "legendFormat": "{{ model }}"
        }
      ],
      "title": "Cost Rate by Model (USD/hour)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102,
      "title": "Cost Breakdown",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 7,
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut"
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_cost_usd_total[1h])) by (framework)",
          "legendFormat": "{{ framework }}"
        }
      ],
      "title": "Cost Share by Framework (1h)",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 8,
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut"
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_cost_usd_total{token_type=\"input\"}[1h])) by (model)",
          "legendFormat": "{{ model }} input"
        },
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_cost_usd_total{token_type=\"output\"}[1h])) by (model)",
          "legendFormat": "{{ model }} output"
        }
      ],
      "title": "Input vs Output Cost by Model (1h)",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "uid": "govagn-prometheus" },
          "expr": "sum(rate(govagn_cost_usd_total[5m])) by (tenant_id) * 3600",
          "legendFormat": "tenant: {{ tenant_id }}"
        }
      ],
      "title": "Cost Rate by Tenant (USD/hour)",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["govagn", "cost", "tokens", "ai-agents"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "govagn-prometheus" },
        "definition": "label_values(govagn_cost_usd_total, tenant_id)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "tenant",
        "options": [],
        "query": "label_values(govagn_cost_usd_total, tenant_id)",
        "refresh": 2,
        "type": "query",
        "label": "Tenant"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Govagn — Cost Report",
  "uid": "govagn-cost",
  "version": 1
}
