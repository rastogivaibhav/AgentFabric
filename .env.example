# Govagn — Environment Variable Reference
# ──────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in production values before deploying.
#
#   cp .env.example .env
#
# Convention:
#   (required)    — must be set; service will refuse to start without it
#   (conditional) — required only when a related feature is enabled
#   (optional)    — has a safe default; override for production tuning
#   (dev-only)    — must be REMOVED or set to false/empty in production
#
# Secrets policy:
#   • Never commit .env to version control (.gitignore already excludes it).
#   • In Kubernetes: use secretKeyRef (see deploy/k8s/govagn.yaml).
#   • In production Docker: inject via --env-file or a secrets manager.
#   • Minimum secret length for GV_JWT_SECRET: 32 random bytes (base64url).
#     Generate: openssl rand -base64 32
# ──────────────────────────────────────────────────────────────────────────────


# ═══════════════════════════════════════════════════════════════════════════════
# SHARED — used by more than one service
# ═══════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection string.  All services read the same schema.
# (required)
DATABASE_URL=postgres://fabric:CHANGE_ME@localhost:5432/govagn?sslmode=require

# Redis URL. api-gateway uses DB 2; af-core uses DB 0; keep them separated.
# (required)
REDIS_URL=redis://:CHANGE_ME@localhost:6379/2


# ═══════════════════════════════════════════════════════════════════════════════
# API GATEWAY  (api-gateway/cmd/server/main.go)
# ═══════════════════════════════════════════════════════════════════════════════

# Primary JWT signing secret.  All AF tokens are HMAC-SHA256 signed with this.
# Minimum 32 random bytes.  Treat as a password — rotate periodically.
# (required)
GV_JWT_SECRET=CHANGE_ME_minimum_32_random_bytes

# Zero-downtime JWT secret rotation.  Comma-separated ordered list.
# First entry = active signing key.  All entries accepted for verification.
# Usage: GV_JWT_SECRETS=new-secret,old-secret
# When set, overrides GV_JWT_SECRET for signing.
# (optional — leave empty to use GV_JWT_SECRET only)
GV_JWT_SECRETS=

# HTTP listen address for the API gateway.
# (optional, default: :8080)
LISTEN_ADDR=:8080

# Disable JWT authentication entirely.
# NEVER set to true in production — dev/test only.
# (dev-only, default: false)
GV_AUTH_DISABLED=false

# Enable fail-fast production config validation.
# Recommended for production and release candidates.
# (optional, default: false unless GV_ENV=production)
GV_STRICT_CONFIG=false

# 32-byte AES key encoded as 64 hex chars for virtual key encryption.
# Required for production gateway deployments.
# (required in production)
GV_VAULT_KEY=CHANGE_ME_64_hex_chars

# Per-tenant API rate limit: maximum requests per minute per tenant.
# Requests above this threshold receive HTTP 429 with Retry-After header.
# (optional, default: 1000)
GV_RATE_LIMIT_RPM=1000

# TLS — enable HTTPS on the API gateway HTTP server.
# When true, GV_TLS_CERT_FILE and GV_TLS_KEY_FILE must also be set.
# (optional, default: false)
GV_TLS_ENABLED=false

# Path inside the container to the TLS server certificate (PEM).
# (conditional — required when GV_TLS_ENABLED=true)
GV_TLS_CERT_FILE=/certs/server.crt

# Path inside the container to the TLS server private key (PEM).
# (conditional — required when GV_TLS_ENABLED=true)
GV_TLS_KEY_FILE=/certs/server.key

# Path to the CA certificate for mutual TLS client verification.
# (conditional — required when GV_TLS_ENABLED=true and mTLS is desired)
GV_TLS_CA_FILE=/certs/ca.crt

# Allowed CORS origins for the WebSocket live-stream endpoint.
# Comma-separated list.  Defaults to localhost in dev.
# Production: set to your portal domain, e.g. https://app.govagn.io
# (optional)
GV_CORS_ORIGINS=https://app.govagn.io

# ── Admin (password login) ───────────────────────────────────────────────────

# Username for the built-in admin account (password login, non-OIDC).
# (optional, default: admin — CHANGE in production)
GV_ADMIN_USER=admin

# Password for the built-in admin account.
# Must be changed in production.  Empty = defaults to "admin".
# (required in production)
GV_ADMIN_PASSWORD=CHANGE_ME

# ── OIDC (enterprise SSO — optional) ────────────────────────────────────────
# Leave all GV_OIDC_* empty to use password login only.
# Set GV_OIDC_ISSUER to enable SSO (Okta, Azure AD, Auth0, Google Workspace).

# OIDC provider issuer URL, e.g. https://login.microsoftonline.com/{tenantId}/v2.0
# (conditional — required to enable OIDC/SSO)
GV_OIDC_ISSUER=

# OIDC application client ID from your identity provider.
# (conditional — required when GV_OIDC_ISSUER is set)
GV_OIDC_CLIENT_ID=

# OIDC application client secret.  Treat like a password.
# (conditional — required when GV_OIDC_ISSUER is set)
GV_OIDC_CLIENT_SECRET=

# The callback URL registered in your OIDC provider.
# Must match exactly what the provider has on record.
# (conditional — required when GV_OIDC_ISSUER is set)
GV_OIDC_REDIRECT_URI=https://api.govagn.io/auth/callback

# Provider logout URL.  When set, /auth/logout redirects here.
# e.g. https://login.microsoftonline.com/{tenantId}/oauth2/v2.0/logout
# (optional)
GV_OIDC_LOGOUT_URL=


# ═══════════════════════════════════════════════════════════════════════════════
# COLLECTOR  (collector/cmd/collector/main.go + internal/config)
# Viper reads these as AF_<SECTION>_<KEY> (underscores, uppercase)
# ═══════════════════════════════════════════════════════════════════════════════

# Enable verbose debug logging in the collector.
# (dev-only, default: false)
GV_DEBUG=false

# gRPC OTLP receiver address.
# (optional, default: 0.0.0.0:4317)
GV_GRPC_ADDR=0.0.0.0:4317

# HTTP OTLP receiver address (supports both JSON and protobuf).
# (optional, default: 0.0.0.0:4318)
GV_HTTP_ADDR=0.0.0.0:4318

# URL of the api-gateway ingest endpoint.  Must include scheme.
# (optional, default: http://localhost:8080)
GV_GATEWAY_ENDPOINT=http://api-gateway:8080

# Bearer token the collector uses when posting spans to the gateway.
# Required when GV_AUTH_DISABLED=false on the gateway.
# (conditional)
GV_GATEWAY_AUTH_TOKEN=

# Require JWT authentication on inbound OTLP requests from SDKs.
# Set to false only during initial integration testing.
# (optional, default: true)
GV_AUTH_REQUIRE_AUTH=true

# JWT secret used to validate inbound OTLP bearer tokens.
# Should match the issuing service's GV_JWT_SECRET.
# (conditional — required when GV_AUTH_REQUIRE_AUTH=true)
GV_JWT_SECRET=CHANGE_ME_minimum_32_random_bytes

# Collector TLS (mTLS for the OTLP gRPC port).
# (optional, default: false)
GV_TLS_ENABLED=false
GV_TLS_CERT_FILE=/certs/collector.crt
GV_TLS_KEY_FILE=/certs/collector.key
GV_TLS_CA_FILE=/certs/ca.crt

# Maximum inbound span rate before the collector starts dropping.
# (optional, default: 50000 spans/second)
GV_RATE_LIMIT_SPANS_PER_SECOND=50000

# Burst allowance on top of the rate limit.
# (optional, default: 10000)
GV_RATE_LIMIT_BURST_SIZE=10000

# Number of parallel span processing workers.
# (optional, default: 4)
GV_PROCESSOR_WORKERS=4

# Max spans buffered in the processing queue.
# (optional, default: 100000)
GV_PROCESSOR_MAX_QUEUE_SIZE=100000

# Batch flush size and timeout.
# (optional, defaults: 512 spans / 200 ms)
GV_PROCESSOR_BATCH_SIZE=512
GV_PROCESSOR_BATCH_TIMEOUT_MS=200

# Enable PII scrubbing on all span attributes.
# Disable only for internal-only deployments where data never leaves the tenant.
# (optional, default: true — leave true in production)
GV_PII_ENABLED=true

# Redact matched PII values (true) vs. hash them (false).
# Hashing preserves correlation; redacting is stronger.
# (optional, default: true)
GV_PII_REDACT=true

# Auto-discover running agent processes (host-mode deployment).
# (optional, default: true)
GV_DISCOVERY_ENABLED=true

# Enable Kubernetes pod discovery mode.
# (optional, default: false — set true in K8s deployments)
GV_DISCOVERY_KUBERNETES_MODE=false


# ═══════════════════════════════════════════════════════════════════════════════
# AF-CORE  (af-core/src/config.rs — Rust, no prefix, __ separator for nesting)
# ═══════════════════════════════════════════════════════════════════════════════

# af-core uses the same DATABASE_URL as api-gateway (shared schema).
# DATABASE_URL already declared in the SHARED section above.

# ClickHouse HTTP URL.  Used for analytics time-series writes.
# (optional, default: http://localhost:8123)
CLICKHOUSE_URL=http://clickhouse:8123

# af-core gRPC server address (internal, not exposed externally).
# (optional, default: 0.0.0.0:50051)
GRPC_ADDR=0.0.0.0:50051

# af-core HTTP metrics/admin address.
# (optional, default: 0.0.0.0:8889)
HTTP_ADDR=0.0.0.0:8889

# Enable Kafka consumer for durable span buffering.
# When false, af-core accepts spans directly via gRPC from the collector.
# (optional, default: false)
KAFKA_ENABLED=false

# Kafka broker addresses, comma-separated.
# (conditional — required when KAFKA_ENABLED=true)
KAFKA_BROKERS=kafka:9092

# Kafka topic name for span events.
# (optional, default: af.spans)
KAFKA_TOPIC=af.spans

# Default tenant ID for unauthenticated/unmapped spans.
# (optional, default: default)
DEFAULT_TENANT_ID=default

# Policy engine: per-tenant cost alert threshold in USD.
# Spans contributing to cost above this trigger an audit entry + alert.
# (optional, default: 10.0)
COST_THRESHOLD_USD=10.0

# Policy engine: inbound span rate limit per tenant per minute.
# (optional, default: 10000)
RATE_LIMIT_SPANS_PER_MIN=10000

# Rust structured log filter.  Format: crate=level,crate2=level
# (optional, default: af_core=info)
RUST_LOG=af_core=info


# ═══════════════════════════════════════════════════════════════════════════════
# PORTAL  (Vite build-time — injected via docker-compose args or .env.local)
# These are compiled into the static bundle at build time, not runtime.
# ═══════════════════════════════════════════════════════════════════════════════

# Public URL of the API gateway, reachable from the user's browser.
# (optional, default: http://localhost:8080)
VITE_API_URL=https://api.govagn.io

# WebSocket URL for the live stream (ws:// or wss://).
# Must match the domain serving the api-gateway.
# (optional, default: ws://localhost:8080)
VITE_WS_URL=wss://api.govagn.io

# Disable the auth gate in the portal (shows all pages without login).
# (dev-only, default: false)
VITE_AUTH_DISABLED=false

# Show the "Default credentials: admin / admin" hint on the login page.
# Remove in production — set to false.
# (dev-only, default: true)
VITE_SHOW_DEFAULT_CREDS=false
